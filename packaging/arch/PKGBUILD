# Maintainer: WinMedia Linux Contributors <https://github.com/ceuw/WinMedia-Linux>
pkgname=winmedia-linux
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux-native PySide6 app for Windows installation media workflows (safety-gated)"
arch=('any')
url="https://github.com/ceuw/WinMedia-Linux"
license=('MIT')
depends=('python' 'pyside6')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=(
  'util-linux: device information (lsblk)'
  'udisks2: disk management integration'
  'parted: partitioning tools'
  'dosfstools: FAT filesystem tools'
  'ntfs-3g: NTFS support'
  'wimlib: WIM/SWM handling (wimlib-imagex)'
)
options=(!emptydirs)
source=("$pkgname-$pkgver.tar.gz::https://github.com/ceuw/WinMedia-Linux/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # Replace with the real checksum from the release/tag tarball before publishing to AUR

build() {
  cd "$srcdir/WinMedia-Linux-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/WinMedia-Linux-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
